# Copia este archivo a .env.local y completa con tus valores reales.
# .env.local esta gitignored: nunca se commitea.

# API key administrativa (RNF-11): los endpoints administrativos responden 503
# sin ella (fail-closed). Debe ser la MISMA que VITE_ADMIN_API_KEY del frontend
# (pasteleria-my-dreams-react/.env.development).
APP_ADMIN_API_KEY=PEGA_AQUI_EL_MISMO_VALOR_DE_VITE_ADMIN_API_KEY

# Opcional: la base (MySQL docker) y catalogo-service ya tienen default local
# en application.properties. Descomenta solo si tu entorno difiere del default.
# DB_URL=jdbc:mysql://localhost:3306/pasteleria_my_dreams?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# DB_USER=root
# DB_PASS=
# CATALOGO_URL=http://localhost:8080
